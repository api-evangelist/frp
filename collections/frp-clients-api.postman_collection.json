              "path": [
                "api",
                "clients"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "user",
                  "value": "<string>",
                  "description": "Filter by client user name"
                },
                {
                  "disabled": false,
                  "key": "clientId",
                  "value": "<string>",
                  "description": "Filter by client identifier"
                },
                {
                  "disabled": false,
                  "key": "runId",
                  "value": "<string>",
                  "description": "Filter by frpc run identifier"
                },
